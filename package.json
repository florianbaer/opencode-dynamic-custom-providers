{
  "name": "opencode-dynamic-custom-providers",
  "version": "3.0.0",
  "description": "Dynamic model discovery for OpenAI-compatible providers in OpenCode V2 with models.dev enrichment",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "default": "./dist/rpc.js"
    }
  },
  "scripts": {
    "compile": "tsc",
    "test": "npm run compile && node --test tests/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "ai",
    "openai",
    "dynamic",
    "discovery",
    "models.dev"
  ],
  "author": "b3nw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/b3nw/opencode-dynamic-custom-providers.git"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "opencode": ">=2.2.0"
  }
}
