{
  "name": "opencode-dynamic-custom-providers",
  "version": "3.0.0",
  "description": "Dynamic model discovery for OpenAI-compatible providers in OpenCode V2 with models.dev enrichment",
  "type": "module",
  "main": "./src/server.ts",
  "types": "./src/server.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/server.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "opencode",
    "plugin",
    "ai",
    "openai",
    "dynamic",
    "discovery",
    "models.dev"
  ],
  "author": "b3nw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/b3nw/opencode-dynamic-custom-providers.git"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "opencode": ">=2.2.0"
  }
}
